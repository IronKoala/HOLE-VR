# Writes a C++ source holding every file under SRC_DIR (except README.md) as a
# byte array, for src/core/builtin_files.cpp. Run with
#   cmake -DSRC_DIR=<defaults folder> -DOUT=<file.cpp> -P embed_files.cmake
get_filename_component(SRC_DIR "${SRC_DIR}" ABSOLUTE)
file(GLOB_RECURSE files RELATIVE "${SRC_DIR}" "${SRC_DIR}/*")
list(FILTER files EXCLUDE REGEX "(^|/)README\\.md$")
list(SORT files)

set(arrays "")
set(table "")
set(n 0)
foreach(rel IN LISTS files)
    file(READ "${SRC_DIR}/${rel}" hex HEX)
    string(LENGTH "${hex}" hexlen)
    math(EXPR size "${hexlen} / 2")
    if(size EQUAL 0)
        continue()
    endif()
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    # Wrap the long line every 24 bytes.
    string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){24})" "\\1\n    " bytes "${bytes}")
    string(REPLACE "/" "\\\\" winrel "${rel}")
    string(APPEND arrays "// ${rel}\nconst unsigned char k${n}[] = {\n    ${bytes}\n};\n")
    string(APPEND table "    {L\"${winrel}\", k${n}, ${size}},\n")
    math(EXPR n "${n} + 1")
endforeach()

if(n EQUAL 0)
    set(table "    {nullptr, nullptr, 0},\n")
endif()

set(content "// Generated by cmake/embed_files.cmake from defaults/. Do not edit.\n#include \"core/builtin_files.h\"\n\nnamespace holevr::builtin_files {\nnamespace {\n${arrays}}  // namespace\n\nconst File kFiles[] = {\n${table}};\nconst int kFileCount = ${n};\n\n}  // namespace holevr::builtin_files\n")

# Only touch the output when it changed, so a rebuild stays incremental.
if(EXISTS "${OUT}")
    file(READ "${OUT}" old)
    if(old STREQUAL content)
        return()
    endif()
endif()
file(WRITE "${OUT}" "${content}")
