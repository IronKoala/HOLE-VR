// Version info so the installer (and Explorer's Properties > Details) can tell
// the HOLE VR dxgi.dll apart from other mods that also ship a dxgi.dll.
#include <winver.h>
#include "version.h"

VS_VERSION_INFO VERSIONINFO
FILEVERSION HOLEVR_VERSION_MAJOR, HOLEVR_VERSION_MINOR, HOLEVR_VERSION_PATCH, 0
PRODUCTVERSION HOLEVR_VERSION_MAJOR, HOLEVR_VERSION_MINOR, HOLEVR_VERSION_PATCH, 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "ProductName", HOLEVR_PRODUCT_NAME
            VALUE "FileDescription", "HOLE VR mod loader (dxgi proxy)"
            VALUE "ProductVersion", HOLEVR_VERSION_STR
            VALUE "FileVersion", HOLEVR_VERSION_STR
            VALUE "OriginalFilename", "dxgi.dll"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
